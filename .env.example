# Copy to `.env` and fill in. `.env*` is gitignored.

# Base URL of the Fox Passport API (include the /api/v1 prefix if your client expects it).
NEXT_PUBLIC_API_URL=http://localhost:6002/api/v1

# Public client keys
NEXT_PUBLIC_MAPBOX_TOKEN=
NEXT_PUBLIC_CESIUM_ION_TOKEN=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Base URL for static brand/marketing images (source: static-assets/), no trailing slash.
# MinIO (dev):  http://localhost:9000/fox-passport-dev/static  (the API's docker compose uploads them)
# S3/CDN (prod): https://<cdn-domain>/static
# Empty, the images 404 - they are no longer in public/. See static-assets/README.md.
NEXT_PUBLIC_ASSETS_URL=
