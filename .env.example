# Copy to `.env` and fill in. `.env*` is gitignored.

# Base URL of the Fox Passport API (include the /api/v1 prefix if your client expects it).
NEXT_PUBLIC_API_URL=http://localhost:3002/api/v1

# Server-side only — NOT exposed to the browser.
# Must be byte-identical to ACCESS_TOKEN_SECRET in the API, because the proxy
# in middleware.ts verifies access tokens that the API signed. If this is unset,
# the proxy fails closed and every protected route redirects to `/`.
ACCESS_TOKEN_SECRET=

# Public client keys
NEXT_PUBLIC_MAPBOX_TOKEN=
NEXT_PUBLIC_CESIUM_ION_TOKEN=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
